<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.tzui.psdtools.layer-tagger"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="PSD Layer Tagger"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.tzui.psdtools.layer-tagger.panel" Version="1.0.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHSP" Version="[21.0,99.9]"/>
      <Host Name="PHXS" Version="[21.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.tzui.psdtools.layer-tagger.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>PSD Layer Tagger</Menu>
          <Geometry>
            <Size>
              <Width>360</Width>
              <Height>580</Height>
            </Size>
            <MinSize>
              <Width>300</Width>
              <Height>420</Height>
            </MinSize>
            <MaxSize>
              <Width>720</Width>
              <Height>1200</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
